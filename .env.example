# Skillego server configuration
# Copy this file to .env and adjust values for your environment

# Port the server listens on (default: 3000)
PORT=3000

# Allowed origins for cross-origin WebSocket connections.
# Comma-separated. Use * for development, lock down for production.
# Example: https://yourusername.github.io,https://crisiscontrol.app
ALLOWED_ORIGINS=*
